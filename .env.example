# GHCR images built by .github/workflows/build-docker.yml
MEMORY_CORE_IMAGE=ghcr.io/${OWNER}/memory-core:latest
MEMORY_KNOWLEDGE_IMAGE=ghcr.io/${OWNER}/memory-knowledge:latest
MEMORY_PANEL_IMAGE=ghcr.io/${OWNER}/memory-panel:latest
MEMORY_PROXY_IMAGE=ghcr.io/${OWNER}/memory-proxy:latest

# Host ports
MEMORY_CORE_PORT=8420
KNOWLEDGE_PORT=8421
PANEL_PORT=8123
PROXY_PORT=8096
MEMORY_CORE_API_KEY=local

# MemoryCore and MemoryKnowledge LLM settings. Replace these values.
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_API_KEY=replace-with-your-api-key
MEMORY_LLM_MODEL=gpt-4o-mini
KNOWLEDGE_LLM_MODE=custom
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8421/v3
TMC_CALLBACK_URL=
KNOWLEDGE_AUTH_TOKEN=

# MemoryProxy upstream LLM settings. Replace these values.
PROXY_UPSTREAM_URL=https://api.openai.com/v1
PROXY_UPSTREAM_API_KEY=replace-with-your-api-key